APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Production must use: APP_ENV=production, APP_DEBUG=false, HTTPS, and a strong APP_KEY.

# Trusted proxy / host configuration.
# Railway does not publish stable edge proxy ranges, so leave TRUSTED_PROXIES empty
# and rely on Railway's edge plus network isolation (no TCP proxy / direct port).
# Set TRUSTED_PROXIES only to explicit addresses when they are documented by the platform.
TRUSTED_PROXIES=
# When true (default on Railway), the rightmost X-Forwarded-For address is treated as
# the client IP. This is only safe when direct access to the container is blocked.
TRUST_PROXY_HEADERS=true
# Comma-separated hostnames accepted by the application. Defaults to the APP_URL host.
TRUSTED_HOSTS=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# SESSION_SECURE_COOKIE=true

# Administrator sessions expire after this many minutes of inactivity and after
# the absolute lifetime, whichever comes first.
ADMIN_IDLE_TIMEOUT=60
ADMIN_SESSION_LIFETIME=480

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
CATALOG_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Set true only for local/test sandbox simulations; never for production.
PAYMENT_SANDBOX_ENABLED=false

# Live payment webhook verification. Disabled by default; the endpoint returns 404
# unless both PAYMENT_WEBHOOK_ENABLED=true and a strong PAYMENT_WEBHOOK_SECRET are set.
PAYMENT_WEBHOOK_ENABLED=false
PAYMENT_WEBHOOK_SECRET=

# XentriPay mobile money collections. Keep the API key server-side only.
# Sandbox base URL: https://merchant.test.xentripay.com
XENTRIPAY_ENABLED=false
XENTRIPAY_BASE_URL=https://merchant.test.xentripay.com
XENTRIPAY_API_KEY=
# true: fee deducted from the amount. false: fee added on top. Match your approved XentriPay setting.
XENTRIPAY_CHARGES_INCLUDED=true
# Optional: only needed if you register a signed webhook. Status polling works without it.
XENTRIPAY_WEBHOOK_SECRET=

# Optional one-time inputs for `php artisan admin:create`; prefer interactive prompts.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Operational monitoring. Defaults to enabled only when APP_ENV=production.
MONITORING_ENABLED=false
# Slack-compatible incoming webhook (Slack, Mattermost, or any JSON endpoint with a "text" field).
MONITORING_ALERT_WEBHOOK=
MONITORING_ALERT_MIN_SECONDS=300
MONITORING_RETENTION_DAYS=30
MONITORING_WINDOW_MINUTES=15
MONITORING_FAILED_JOBS_THRESHOLD=5
MONITORING_STUCK_PAYMENTS_MINUTES=20
MONITORING_STUCK_PAYMENTS_COUNT=3
MONITORING_WEBHOOK_FAILURES_THRESHOLD=5
MONITORING_ADMIN_FAILURES_THRESHOLD=10
